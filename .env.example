# Copy to .env and fill in. .env is git-ignored; never commit real keys.
# Judges: the values for judging are sent in the submission form, not here.
# To use every feature, connect all three: OpenAI, Adapty (the logged-in CLI and a seeded Lumen app) and Slack.
# Without them, only the computed numbers work: AI writing and images need OpenAI, drafts in Adapty need the CLI, and Slack alerts need the webhook.

# OpenAI key: one key for all AI in the app.
#  - text: the campaign, every language, the meaning check, the insight explanations
#  - images: text-free banner visuals
OPENAI_API_KEY=
# OPENAI_TEXT_MODELS=gpt-5.5,gpt-5.4-mini,gpt-4.1-mini   # tried in order; falls back on no-access / not-found / rate-limit / server errors
# OPENAI_TEXT_EFFORT=medium   # optional reasoning effort: low | medium | high
# OPENAI_IMAGE_MODEL_CACHED=gpt-image-2.6-sunburst
# OPENAI_IMAGE_MODEL_LIVE=gpt-image-2.6-flare
# OPENAI_IMAGE_FALLBACKS=gpt-image-2.5-sunburst,gpt-image-2,gpt-image-1.5
# OPENAI_IMAGE_QUALITY=high

# Paywalls, onboardings, segments and A/B tests are drafted in the seeded Lumen app through the Adapty CLI (setup in the README).
# Leave empty and the app finds Lumen by its title.
ADAPTY_APP_ID=
# ADAPTY_BASE_FLOW_NAME=Main - 3 plans
# ADAPTY_CLI_JS=   # path to the CLI's bin/run.js if it isn't in the default global npm folder

# Secret API key of the Lumen app (Adapty dashboard -> App settings -> General); not used by the app yet
ADAPTY_SECRET_KEY=

# Slack incoming webhook for Watch alerts (without it alerts only show as a preview)
SLACK_WEBHOOK_URL=
